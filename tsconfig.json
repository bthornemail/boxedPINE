{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
      "lib": ["ES2023", "ESNext", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/testbed", "src/define.commands.ts", "src/server.ts", "src/america.ts", "src/angela.ts", "src/eve.ts", "src/main.ts", "src/mertens.ts", "src/m-expr.ts", "src/omnicron.ts", "src/prompt.treemap.ts", "src/red40.ts", "src/trinity.ts"]
}
